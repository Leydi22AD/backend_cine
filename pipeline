pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        DOCKER_PROJECT_NAME = 'cineproject'
        APP_CONTAINER_NAME = 'app-cine'
        DB_CONTAINER_NAME = 'mysql-cine'
        DB_NAME = 'cine'
        DB_USER = 'root'
        DB_PASSWORD = 'admin'
        REPO_URL = 'https://github.com/Leydi22AD/backend_cine.git'
    }

    stages {
        stage('Clone') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo '🔄 === INICIO: CLONACIÓN DEL REPOSITORIO ==='
                    cleanWs()
                    git branch: 'master', url: "${REPO_URL}"
                    echo '✅ === FIN: CLONACIÓN COMPLETADA ==='
                }
            }
        }

        stage('Build') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo '🔨 === INICIO: CONSTRUCCIÓN DEL PROYECTO ==='
                    sh 'mvn -DskipTests clean package'
                    echo '✅ === FIN: CONSTRUCCIÓN COMPLETADA ==='
                }
            }
        }

        stage('Test') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    echo '🧪 === INICIO: EJECUCIÓN DE PRUEBAS ==='
                    sh 'mvn clean verify'
                    echo '✅ === FIN: PRUEBAS COMPLETADAS ==='
                }
            }
        }

        stage('Sonar Analysis') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo '📊 === INICIO: ANÁLISIS DE CALIDAD ==='
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml'
                    }
                    echo '✅ === FIN: ANÁLISIS DE CALIDAD COMPLETADO ==='
                }
            }
        }

        stage('Deploy Application') {
            steps {
                echo '🚀 === INICIO: PROCESO DE DESPLIEGUE ==='
                script {
                    echo '1️⃣ Limpiando despliegue anterior...'
                    sh "docker-compose -p ${DOCKER_PROJECT_NAME} down -v --remove-orphans || true"

                    echo '2️⃣ Construyendo y levantando servicios...'
                    sh "docker-compose -p ${DOCKER_PROJECT_NAME} up -d --build"

                    echo '3️⃣ Esperando estabilización de servicios...'
                    sleep(30)

                    echo '4️⃣ Verificando logs de la aplicación:'
                    sh "docker logs --tail 100 ${APP_CONTAINER_NAME}"
                }
                echo '✅ === FIN: DESPLIEGUE COMPLETADO ==='
            }
        }
    }

    post {
        always {
            echo '🏁 === FINALIZACIÓN DEL PIPELINE ==='
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            jacoco execPattern: 'target/*.exec', classPattern: 'target/classes', sourcePattern: 'src/main/java'
        }
        success {
            echo '🎉 ✓ Pipeline completado exitosamente'
        }
        failure {
            echo '💥 ✗ Pipeline falló'
        }
    }
}