pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    stages {
        stage('Clone') {
            steps {
                cleanWs()
                git branch: 'master', url: 'https://github.com/Leydi22AD/backend_cine.git'
            }
        }

        stage('Build & Test') {
            steps {
                // He añadido -Dspring.profiles.active=test para forzar el uso de H2
                sh 'mvn clean verify -Dspring.profiles.active=test'
            }
        }

        stage('Sonar Analysis') {
            steps {
                // Asegúrate de que este nombre sea EXACTO al de tu config de Jenkins
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

      stage('Deploy') {
                  steps {
                      echo '🚀 === LIMPIANDO Y DESPLEGANDO... ==='
                      script {
                          // 1. Forzamos la eliminación de todo lo relacionado con este proyecto
                          // El '|| true' hace que no falle si el contenedor no existe
                          sh "docker-compose -p ${DOCKER_PROJECT_NAME} down -v --remove-orphans || true"

                          // 2. Por si acaso queda un "fantasma" con el nombre específico, lo eliminamos a la fuerza
                          sh "docker rm -f mysql-cine app-cine || true"

                          // 3. Levantamos todo de nuevo
                          sh "docker-compose -p ${DOCKER_PROJECT_NAME} up -d --build"
                      }
                  }
              }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            // Quitamos el jacoco por ahora hasta que instales el plugin
            echo '🏁 Pipeline finalizado.'
        }
        success { echo '🎉 ¡Exito!' }
        failure { echo '💥 Pipeline fallido.' }
    }
}