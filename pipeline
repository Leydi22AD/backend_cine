pipeline {
    agent any

    tools {
        // Debes verificar en 'Global Tool Configuration' si se llama 'MAVEN_HOME', 'Maven3' o 'maven-3.9'
        // Si tienes dudas, ve a Jenkins -> Manage Jenkins -> Global Tool Configuration y copia el nombre
        maven 'MAVEN_HOME'
    }

    environment {
        DOCKER_PROJECT_NAME = 'cineproject'
        APP_CONTAINER_NAME = 'app-cine'
        DB_CONTAINER_NAME = 'mysql-cine'
        DB_NAME = 'cine'
        DB_USER = 'root'
        DB_PASSWORD = 'admin'
        REPO_URL = 'https://github.com/Leydi22AD/backend_cine.git'
    }

    stages {
        stage('Clone') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo '🔄 === INICIO: CLONACIÓN ==='
                    cleanWs()
                    git branch: 'master', url: "${REPO_URL}"
                }
            }
        }

        stage('Build') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo '🔨 === INICIO: CONSTRUCCIÓN ==='
                    sh 'mvn -DskipTests clean package'
                }
            }
        }

        stage('Test') {
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    echo '🧪 === INICIO: PRUEBAS ==='
                    sh 'mvn clean verify'
                }
            }
        }

        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo '🚀 === INICIO: DESPLIEGUE ==='
                    try {
                        sh "docker-compose -p ${DOCKER_PROJECT_NAME} down -v --remove-orphans"
                    } catch (Exception e) {
                        echo "⚠️ Limpieza previa..."
                    }
                    sh "docker-compose -p ${DOCKER_PROJECT_NAME} up -d --build"
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            jacoco execPattern: 'target/*.exec', classPattern: 'target/classes', sourcePattern: 'src/main/java'
        }
        success { echo '🎉 Pipeline completado!' }

    }
}