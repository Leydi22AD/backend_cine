pipeline {
    agent any

    // 💡 He ajustado el bloque tools para que sea más tolerante
    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        DOCKER_PROJECT_NAME = 'cineproject'
        // ... (tus otras variables)
    }

    stages {
        stage('Clone') {
            steps {
                echo '🔄 === CLONANDO... ==='
                cleanWs()
                git branch: 'master', url: 'https://github.com/Leydi22AD/backend_cine.git'
            }
        }

        stage('Build & Test') {
            steps {
                echo '🔨 === CONSTRUYENDO Y TESTEANDO... ==='
                // Unimos Build y Test para optimizar tiempo en el contenedor
                sh 'mvn clean verify'
            }
        }

        stage('Sonar Analysis') {
            steps {
                echo '📊 === ANALIZANDO SONARQUBE ==='
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 === DESPLEGANDO... ==='
                script {
                    // Verificamos si docker-compose existe antes de intentar bajar nada
                    sh 'docker-compose -v'
                    sh "docker-compose -p ${DOCKER_PROJECT_NAME} down -v --remove-orphans || true"
                    sh "docker-compose -p ${DOCKER_PROJECT_NAME} up -d --build"
                }
            }
        }
    }

    post {
            always {
                echo '🏁 === FINALIZACIÓN DEL PIPELINE ==='
                junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                jacoco execPattern: 'target/*.exec', classPattern: 'target/classes', sourcePattern: 'src/main/java'
            }
            success {
                echo '🎉 Pipeline completado con éxito.'
            }
            failure {
                // 💡 Eliminamos la línea 'mail' que estaba intentando conectar a un servidor inexistente
                echo '💥 PIPELINE FALLÓ: Revisa los logs de los stages anteriores para ver el error real.'
            }
        }