pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        DOCKER_PROJECT_NAME = 'cineproject'
    }

    stages {
        stage('Clone') {
            steps {
                cleanWs()
                git branch: 'master', url: 'https://github.com/Leydi22AD/backend_cine.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean verify -Dspring.profiles.active=test'
            }
        }

        stage('Sonar Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 === LIMPIANDO Y DESPLEGANDO... ==='
                script {
                    sh "docker-compose -p ${env.DOCKER_PROJECT_NAME} down -v --remove-orphans || true"
                    sh "docker rm -f mysql-cine app-cine || true"
                    sh "docker-compose -p ${env.DOCKER_PROJECT_NAME} up -d --build"
                }
            }
        }
    } // <--- Esta llave cierra el bloque "stages"

    post {
        always {
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            echo '🏁 Pipeline finalizado.'
        }
        success { echo '🎉 ¡Exito!' }
        failure { echo '💥 Pipeline fallido.' }
    }
}